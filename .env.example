# Telegram (SOLO para notificaciones de alertas; opcional)
# Si lo dejas vacío, las alertas solo se ven en el dashboard web.
TELEGRAM_BOT_TOKEN=

# OpenAI (generación de contenido e imágenes)
OPENAI_API_KEY=your_openai_api_key_here

# Base de datos
# Local (SQLite, por defecto):
#   DATABASE_URL=sqlite:///data/gestor_redes.db
# Supabase (PostgreSQL en producción):
DATABASE_URL=sqlite:///data/gestor_redes.db
#   Ejemplo Supabase:
#   DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_HOST.supabase.co:5432/postgres

# Selenium / navegadores
# En contenedores (Railway/Docker/K8s) el default ya es true (headless rinde mas);
# define HEADLESS=false solo si necesitas Chrome visible bajo Xvfb.
HEADLESS=false        # false en local (ves Chrome para depurar); en contenedores el default ya es true
MAX_BROWSERS=3        # 3 = ~200+ publicaciones/hora; 1 = mas conservador (proxy/RAM); sube solo con margen

# API HTTP de X (RT, likes, posts, comentarios y citas SIN abrir Chrome)
# Presupuesto TOTAL de una accion por API en segundos: si se agota no sigue
# esperando y el motor cae a Selenium. API_HTTP_TIMEOUT es el tope por peticion.
# API_TIMEOUT_SEG=10
# API_HTTP_TIMEOUT=8
# Disyuntor por grupo de rol (rt / like / tweet): tras API_BREAKER_FALLOS fallos
# DUROS consecutivos (anti-bot 226, limite diario 344, 403/429/404, 422
# persistente) la API de ese grupo se corta API_BREAKER_SEG segundos, para no
# pagar queryId + reintento + 422 en CADA cuenta antes de caer a Selenium.
# API_BREAKER_FALLOS=3
# API_BREAKER_SEG=600
# Bloqueo por cuenta con 344/226: no se vuelve a intentar por API ese tiempo.
# API_CUENTA_BLOQUEO_SEG=600
# Trabajadores simultaneos del motor de activacion. Default 12: las acciones
# API corren en paralelo (no abren Chrome) y los fallbacks Selenium esperan el
# gate adaptativo de navegadores (MAX_BROWSERS).
# MAX_WORKERS=12

# Pestana persistente (recomendado): cada navegador se abre UNA vez por campana
# y entre cuentas solo cambia la sesion EN CALIENTE en la misma pestana
# (cookies + user-agent + proxy sticky), como la app de referencia del jefe.
# MODO_PESTANA=1                  # 1 = activado (default); 0 = un Chrome por accion (modo viejo)
# PESTANA_MAX_ACCIONES=40         # acciones por pestana antes de reciclarla (cerrar y abrir otra)
# PESTANA_ESPERA_SEG=180          # maximo que un worker espera una pestana libre antes de usar el modo clasico
# CAMBIO_CUENTA_CACHE_TIMEOUT=3   # tope (s) para limpiar la cache del navegador al cambiar de cuenta (0 = omitir)
# 0 (default) = omitir en campanas rapidas las cuentas que SOLO tienen password
# (su login con password/TOTP es lento y suele fallar); 1 = permitirlas.
# ACTIVACION_PERMITIR_PASSWORD=0

# Ahorro de datos del proxy residencial (Chrome no gastará GB en trafico de fondo)
CHROME_BLOQUEAR_GOOGLE=true   # bloquea telemetria/updates de Google dentro de Chrome
CHROME_SIN_IMAGENES=false     # true = Chrome no carga imagenes (ahorra mas GB; desactivado por defecto)
# CHROME_DRIVER_LOCK_TIMEOUT=180  # segundos max. esperando el lock del chromedriver compartido

# Security
SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/gestor_redes.log

# Smartproxy residencial (México, sticky 15 min)
SMARTPROXY_HOST=proxy.smartproxy.net
SMARTPROXY_PORT=3120
SMARTPROXY_USER=smart-<tu_subcuenta>
SMARTPROXY_PASSWORD=tu_password
SMARTPROXY_COUNTRY=MX
SMARTPROXY_LIFE=15
SMARTPROXY_SESSION_LENGTH=8
# Sondear x.com por cada proxy cuesta ~0.5-1.5s por accion: se cachea la
# validacion por proceso este numero de segundos (0 = sondear siempre).
# PROXY_X_CACHE_SEG=300
# Reintentos de rotacion de sesion sticky cuando un proxy no alcanza x.com.
# PROXY_X_INTENTOS=5
