# Telegram (SOLO para notificaciones de alertas; opcional)
# Si lo dejas vacío, las alertas solo se ven en el dashboard web.
TELEGRAM_BOT_TOKEN=

# OpenAI (generación de contenido e imágenes)
OPENAI_API_KEY=your_openai_api_key_here

# Base de datos
# Local (SQLite, por defecto):
#   DATABASE_URL=sqlite:///data/gestor_redes.db
# Supabase (PostgreSQL en producción):
DATABASE_URL=sqlite:///data/gestor_redes.db
#   Ejemplo Supabase:
#   DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_HOST.supabase.co:5432/postgres

# Selenium / navegadores
HEADLESS=false        # false en local (ves Chrome para depurar); true en Railway
MAX_BROWSERS=3        # 2-4 recomendado; sube solo si tienes más RAM

# Security
SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/gestor_redes.log

# Smartproxy residencial (México, sticky 15 min)
SMARTPROXY_HOST=proxy.smartproxy.net
SMARTPROXY_PORT=3120
SMARTPROXY_USER=smart-<tu_subcuenta>
SMARTPROXY_PASSWORD=tu_password
SMARTPROXY_COUNTRY=MX
SMARTPROXY_LIFE=15
SMARTPROXY_SESSION_LENGTH=8
