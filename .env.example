# Plantilla de variables de entorno (copiala a .env y ajusta los secretos).
# En Railway las variables se configuran en el panel "Variables" del servicio
# (bot / dashboard-web); el archivo .env NO se sube al repositorio (gitignore).
# Los valores marcados como "recomendado en campana" ya vienen fijados abajo.

# Telegram (SOLO para notificaciones de alertas; opcional)
# Si lo dejas vacío, las alertas solo se ven en el dashboard web.
TELEGRAM_BOT_TOKEN=

# Bot de Telegram para CLIENTES no técnicos (paquete `bot_clientes/`).
# Es un bot INDEPENDIENTE del interno: créalo aparte con @BotFather y pega
# aquí su token. Ofrece con botones: código de verificación de X (2FA TOTP o
# código del correo de la cuenta), cambiar nombre, foto de perfil y portada.
# Arranque: python -m bot_clientes.main
TELEGRAM_CLIENTES_BOT_TOKEN=
# Los clientes se registran en data/clientes_bot.json con /asignar (solo
# admin). Los admins de /clientes /asignar /quitar salen de TELEGRAM_ADMIN_IDS
# (los mismos del bot interno); ej: TELEGRAM_ADMIN_IDS=123456789,987654321
# TELEGRAM_ADMIN_IDS=

# OpenAI (generación de contenido e imágenes)
OPENAI_API_KEY=your_openai_api_key_here

# Base de datos
# Local (SQLite, por defecto):
#   DATABASE_URL=sqlite:///data/gestor_redes.db
# Supabase (PostgreSQL en producción):
DATABASE_URL=sqlite:///data/gestor_redes.db
#   Ejemplo Supabase:
#   DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_HOST.supabase.co:5432/postgres

# Selenium / navegadores
# En contenedores (Railway/Docker/K8s) el default ya es true (headless rinde mas);
# define HEADLESS=false solo si necesitas Chrome visible bajo Xvfb.
HEADLESS=false        # false en local (ves Chrome para depurar); en contenedores el default ya es true
MAX_BROWSERS=2        # pestana persistente: 2 = equilibrado (3-4 si hay RAM y GB de proxy); 1 = conservador

# API HTTP de X (RT, likes, posts, comentarios y citas SIN abrir Chrome)
# RECOMENDADO EN CAMPANA: OFF (0). X bloquea/limita la API (anti-bot 226,
# limite diario 344, 422); con la pestana persistente Selenium rinde igual.
# API_PRIMERO es el interruptor maestro y RT_POR_API queda como alias/compat.
API_PRIMERO=0
RT_POR_API=0
# Presupuesto TOTAL de una accion por API en segundos: si se agota no sigue
# esperando y el motor cae a Selenium. API_HTTP_TIMEOUT es el tope por peticion.
# API_TIMEOUT_SEG=10
# API_HTTP_TIMEOUT=8
# Disyuntor por grupo de rol (rt / like / tweet): tras API_BREAKER_FALLOS fallos
# DUROS consecutivos (anti-bot 226, limite diario 344, 403/429/404, 422
# persistente) la API de ese grupo se corta API_BREAKER_SEG segundos, para no
# pagar queryId + reintento + 422 en CADA cuenta antes de caer a Selenium.
# API_BREAKER_FALLOS=3
# API_BREAKER_SEG=600
# Bloqueo por cuenta con 344/226: no se vuelve a intentar por API ese tiempo.
# API_CUENTA_BLOQUEO_SEG=600
# Trabajadores simultaneos del motor de activacion. Default 12: las acciones
# API corren en paralelo (no abren Chrome) y los fallbacks Selenium esperan el
# gate adaptativo de navegadores (MAX_BROWSERS).
MAX_WORKERS=12

# Pestana persistente (recomendado): cada navegador se abre UNA vez por campana
# y entre cuentas solo cambia la sesion EN CALIENTE en la misma pestana
# (cookies + user-agent + proxy sticky), como la app de referencia del jefe.
MODO_PESTANA=1                  # 1 = activado (recomendado); 0 = un Chrome por accion (modo viejo)
PESTANA_MAX_ACCIONES=40         # acciones por pestana antes de reciclarla (cerrar y abrir otra)
# PESTANA_MAX_MINUTOS=20          # edad maxima de una pestana antes de reciclarla (RAM estable)
# PESTANA_ESPERA_SEG=180          # maximo que un worker espera una pestana libre antes de usar el modo clasico
# CAMBIO_CUENTA_CACHE_TIMEOUT=3   # tope (s) para limpiar la cache del navegador al cambiar de cuenta (0 = omitir)
# 0 (default) = omitir en campanas rapidas las cuentas que SOLO tienen password
# (su login con password/TOTP es lento y suele fallar); 1 = permitirlas.
# ACTIVACION_PERMITIR_PASSWORD=0

# Capturar la URL REAL de cada publicacion (posts y citas) para la tabla de
# Reportes: tras publicar se busca el link en los primeros articulos del
# timeline actual (~1-3s, ruta rapida sin navegar) y, solo si no aparece, se
# visita el perfil de la cuenta (~5-10s y GB de proxy). CAPTURAR_URL_POST=0 =
# maxima velocidad SIN links (la tabla mostrara "link no capturado").
# Los RT simples y los likes no generan link (se etiquetan, sin URL).
CAPTURAR_URL_POST=1

# Ahorro de datos del proxy residencial (Chrome no gastará GB en trafico de fondo)
CHROME_BLOQUEAR_GOOGLE=true   # bloquea telemetria/updates de Google dentro de Chrome
CHROME_SIN_IMAGENES=true      # recomendado en campana: no carga imagenes/video y ahorra GB del proxy
# CHROME_DRIVER_LOCK_TIMEOUT=180  # segundos max. esperando el lock del chromedriver compartido

# Calentamiento continuo (scheduler 24/7): mantiene la flota "viva" publicando
# de vez en cuando un texto de mantenimiento organico en una cuenta ALEATORIA,
# a intervalos aleatorios y sin repetir la misma cuenta dentro del gap. Se
# pausa SOLO mientras hay una campana de activacion en curso (marcador
# data/.campana_activa, vigente 90 min); si el scheduler no corre, no publica.
CALENTAMIENTO_ACTIVO=1        # 0 = apagar el calentamiento (no se registra el job)
CALENTAMIENTO_MIN_MIN=15      # minutos minimos entre tandas (aleatorio)
CALENTAMIENTO_MAX_MIN=45      # minutos maximos entre tandas (aleatorio)
CALENTAMIENTO_GAP_HORAS=12    # horas sin repetir la misma cuenta (segun RegistroAccion)
CALENTAMIENTO_POSTS=1         # publicaciones por tanda (1-10)
CALENTAMIENTO_USAR_IA=1       # 1 = texto con IA (cae a local si falla); 0 = solo local

# Cuotas inteligentes por hora (cuentas NO premium de X): maximo de acciones
# EXITOSAS por cuenta dentro de LIMITE_VENTANA_MIN minutos, por rol de
# activacion. El motor consulta el conteo real (RegistroAccion) antes de
# ejecutar y salta la cuenta si ya llego a su cuota. 0 = sin limite ese rol.
CUOTAS_HORARIAS_ACTIVO=1      # 0 = desactiva TODAS las cuotas (ilimitado)
LIMITE_VENTANA_MIN=60         # ventana movil de conteo (minutos)
LIMITE_POSTS_HORA=5           # posts/hashtags por cuenta en la ventana
LIMITE_CITAS_HORA=5           # retweets con cita por cuenta en la ventana
LIMITE_RTS_HORA=7             # retweets simples por cuenta en la ventana
LIMITE_COMENTARIOS_HORA=3     # comentarios/respuestas por cuenta en la ventana

# Tope DIARIO total por cuenta (anti-banderas de X): maximo de acciones
# OPERATIVAS EXITOSAS por cuenta y dia (posts, citas, RTs y comentarios, sin
# importar el rol; no cuentan las fallidas). El motor lo consulta antes de
# ejecutar y descansa la cuenta si ya llego al tope ("Agotada por hoy"). 0 = sin
# tope diario. LIMITE_ACCIONES_DIA sigue aceptandose como alias legado.
CUOTAS_DIARIAS_ACTIVO=1          # 0 = desactiva el tope diario (ilimitado)
LIMITE_DIARIO_POR_CUENTA=12      # acciones operativas exitosas por cuenta al dia (recomendado 10-12)
# LIMITE_ACCIONES_DIA=12         # alias legado de LIMITE_DIARIO_POR_CUENTA
LIMITE_DIA_VENTANA_MIN=1440      # ventana movil del tope diario en minutos (1440 = 24 h)

# Cuentas de RESPALDO: maximo de cuentas de reserva que el motor puede cargar
# para sustituir 1:1 a las que llegan a "Agotada por hoy" (mismo rol; una
# reserva Tier 2 nunca sustituye un rol hashtags). Se eligen desde la UI.
# RESERVA_MAX_CUENTAS=50

# Curva de aceleracion ("Explosion de tendencia", se activa desde la UI):
# fase 1 solo Tier 1 durante CURVA_FASE1_MIN minutos; despues se liberan los
# Tier 2 para RT/citas/comentarios en cascada sobre los posts de los Tier 1.
# CURVA_FASE1_MIN=15             # minutos de la fase 1 (default 15)

# Security
SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/gestor_redes.log

# Smartproxy residencial (México, sticky 15 min)
SMARTPROXY_HOST=proxy.smartproxy.net
SMARTPROXY_PORT=3120
SMARTPROXY_USER=smart-<tu_subcuenta>
SMARTPROXY_PASSWORD=tu_password
SMARTPROXY_COUNTRY=MX
SMARTPROXY_LIFE=15
SMARTPROXY_SESSION_LENGTH=8
# Sondear x.com por cada proxy cuesta ~0.5-1.5s por accion: se cachea la
# validacion por proceso este numero de segundos (0 = sondear siempre).
PROXY_X_CACHE_SEG=300
# Reintentos de rotacion de sesion sticky cuando un proxy no alcanza x.com.
# PROXY_X_INTENTOS=5
